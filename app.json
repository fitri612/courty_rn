{
  "expo": {
    "name": "courtly",
    "slug": "courtly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "courtly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitri612.courtly"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fitri612.courtly"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-2.jpeg",
          "resizeMode": "cover",
          "backgroundColor": "#FFF",
          "dark": {
            "image": "./assets/images/splash-icon-2.jpeg",
            "resizeMode": "cover",
            "backgroundColor": "#FFF"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/poppins/Poppins-Regular.ttf",
            "./assets/fonts/poppins/Poppins-Bold.ttf",
            "./assets/fonts/poppins/Poppins-SemiBold.ttf",
            "./assets/fonts/poppins/Poppins-Medium.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9a0acd3-4341-40e3-aa3f-4b0288b50517"
      }
    }
  }
}